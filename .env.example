LLM_BASE_URL=https://dcc-llm-gw.uab.cat/uabthehack/v1
LLM_API_KEY=
LLM_MODEL=ornith
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# VAPID_SUBJECT: https URL or real mailto. Apple rejects .invalid/localhost (403 BadJwtToken); empty falls back to PUBLIC_BASE_URL when https.
SESSION_SECRET=
TEAMS_WEBHOOK_URL=
# TEAMS_ALARM_WEBHOOK_URL: optional Workflows webhook for critical-alarm cards (own channel). Empty falls back to TEAMS_WEBHOOK_URL.
TEAMS_ALARM_WEBHOOK_URL=
HR_ACCESS_CODE=
# TEST_ACCOUNT: optional "username:password" (password 8+ chars). Creates that employee account in Fàbriques at server start if missing. Leave empty in production unless you want it there.
TEST_ACCOUNT=
# DEMO_LIVE_JOB=1: after each stored answer the engine job runs in the background (debounced, single flight) and HR gets the web push for any new alarm. Plan A for the live phone trigger. When the engine finds no alarm, a labelled "Demo:" alarm is staged on the answerer's own collective, with a faked drop in that segment's latest aggregate. Leave empty outside demos.
DEMO_LIVE_JOB=
# DEMO_LIVE_JOB_DEBOUNCE_MS: wait before the live run starts (default 1500).
DEMO_LIVE_JOB_DEBOUNCE_MS=
# DEMO_QUICK_JOIN=1: onboarding shows an "Enter the demo" button that creates a throwaway account (random username and password, no recovery code) and signs in at once, so jury members scanning the QR skip the form. Leave empty outside demos.
DEMO_QUICK_JOIN=
